      "type": "ArtifactFabricationRequirement",
      "version": 2,
      "id": "input-envelope",
      "statement": "reconcileIssuerRevenueFacts receives one object {cik,asOf,periodKind,maximumAgeDays,companyfacts}; cik is exactly ten decimal digits, asOf a real calendar date YYYY-MM-DD periodKind quarter or annual, maximumAgeDays a positive integer, companyfacts an object whose numeric/string cik denotes same requested integer and whose entityName is a nonempty string and facts object exists. Return TypeError for invalid envelope or malformed identity. Do not mutate inputs.",
      "parameters": [],
      "claimIds": [],
      "sourceSpan": {
