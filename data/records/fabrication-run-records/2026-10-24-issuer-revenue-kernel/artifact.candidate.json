        "startLine": 3,
        "endLine": 3
      }
    },
    {
      "type": "ArtifactFabricationRequirement",
      "version": 2,
      "id": "date-domain",
      "statement": "Parse exact UTC calendar days and reject rollover dates. Eligible observations have finite numeric val, valid start,end,filed day with start<=end<=asOf and filed<=asOf, nonempty accn and form in `10-Q`,`10-Q/A`,`10-K`,`10-K/A`. An invalid observation is excluded, not repaired. fy/fp/frame are not used as dates or duration.",
      "parameters": [],
      "claimIds": [],
      "sourceSpan": {
        "type": "ArtifactFabricationSourceSpan",
        "startLine": 4,
        "endLine": 4
      }
    },
    {
      "type": "ArtifactFabricationRequirement",
      "version": 2,
